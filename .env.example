# Server-only environment variables for local development.
# Names are declared in src/vite-env.d.ts (ImportMetaEnv) — never commit
# real values.

# MET_API_MODE=fixture
#   Pin the collection search to the committed review fixture instead of
#   the live Met API (the offline e2e/discipline default; production
#   statically sees undefined and goes live).
#   Leave unset for live-API behavior.
